{
  "name": "enterprise-elk-harnessing",
  "private": true,
  "scripts": {
    "repl": "../../run.sh enterprise_it_harnessing/elk_harnessing/harness.py",
    "identity": "../../run.sh enterprise_it_harnessing/elk_harnessing/harness.py --tool cloud_identity",
    "skills": "../../run.sh enterprise_it_harnessing/elk_harnessing/harness.py --tool list_skills",
    "load-skill": "../../run.sh enterprise_it_harnessing/elk_harnessing/harness.py --tool load_skill",
    "list-units": "../../run.sh enterprise_it_harnessing/elk_harnessing/harness.py --tool list_business_units",
    "list-forex-markets": "../../run.sh enterprise_it_harnessing/elk_harnessing/harness.py --tool list_services --bu forex-markets",
    "list-shopify-merchants": "../../run.sh enterprise_it_harnessing/elk_harnessing/harness.py --tool list_services --bu shopify-merchants",
    "es-health-forex": "../../run.sh enterprise_it_harnessing/elk_harnessing/harness.py --once \"es_cluster_health business_unit=forex-markets (es-forex-prod).\"",
    "es-health-ecom": "../../run.sh enterprise_it_harnessing/elk_harnessing/harness.py --once \"es_cluster_health business_unit=ecommerce-retail (es-ecom-prod).\"",
    "es-health-customer": "../../run.sh enterprise_it_harnessing/elk_harnessing/harness.py --once \"es_cluster_health business_unit=customer-support (es-customer-prod).\"",
    "es-health-shopify": "../../run.sh enterprise_it_harnessing/elk_harnessing/harness.py --once \"es_cluster_health business_unit=shopify-merchants (es-shopify-prod).\"",
    "search-forex-trades": "../../run.sh enterprise_it_harnessing/elk_harnessing/harness.py --once \"Load elasticsearch-query. es_search_index alias=forex-trades query=error size=20.\"",
    "search-forex-fix": "../../run.sh enterprise_it_harnessing/elk_harnessing/harness.py --once \"es_search_index alias=forex-fix query=disconnect size=20.\"",
    "search-fx-matching": "../../run.sh enterprise_it_harnessing/elk_harnessing/harness.py --once \"es_search_index service=fx-matching-engine query=reject size=20.\"",
    "search-orders": "../../run.sh enterprise_it_harnessing/elk_harnessing/harness.py --once \"es_search_index alias=orders query=saga_failed size=20.\"",
    "search-shipping": "../../run.sh enterprise_it_harnessing/elk_harnessing/harness.py --once \"es_search_index alias=shipping query=carrier_timeout size=20.\"",
    "search-support": "../../run.sh enterprise_it_harnessing/elk_harnessing/harness.py --once \"es_search_index alias=support query=sla_breach size=20.\"",
    "search-shopify-webhooks": "../../run.sh enterprise_it_harnessing/elk_harnessing/harness.py --once \"Load elasticsearch-query. es_search_index alias=shopify-webhooks query=hmac_failed size=20.\"",
    "search-shopify-legacy": "../../run.sh enterprise_it_harnessing/elk_harnessing/harness.py --once \"es_search_index alias=shopify-legacy query=as400 OR soap size=20.\"",
    "dashboards-forex": "../../run.sh enterprise_it_harnessing/elk_harnessing/harness.py --once \"grafana_list_dashboards business_unit=forex-markets (grafana-forex-prod).\"",
    "dashboards-ecom": "../../run.sh enterprise_it_harnessing/elk_harnessing/harness.py --once \"grafana_list_dashboards business_unit=ecommerce-retail.\"",
    "dashboards-fulfillment": "../../run.sh enterprise_it_harnessing/elk_harnessing/harness.py --once \"grafana_list_dashboards business_unit=fulfillment.\"",
    "dashboards-customer": "../../run.sh enterprise_it_harnessing/elk_harnessing/harness.py --once \"grafana_list_dashboards business_unit=customer-support.\"",
    "dashboards-shopify": "../../run.sh enterprise_it_harnessing/elk_harnessing/harness.py --once \"grafana_list_dashboards business_unit=shopify-merchants (grafana-shopify-prod).\"",
    "alerts-forex": "../../run.sh enterprise_it_harnessing/elk_harnessing/harness.py --once \"Load grafana-alerts. grafana_list_alerts business_unit=forex-markets.\"",
    "alerts-ecom": "../../run.sh enterprise_it_harnessing/elk_harnessing/harness.py --once \"grafana_list_alerts business_unit=ecommerce-retail.\"",
    "alerts-shopify": "../../run.sh enterprise_it_harnessing/elk_harnessing/harness.py --once \"Load grafana-alerts. grafana_list_alerts business_unit=shopify-merchants. HMAC rules must stay firing.\"",
    "silence-orders-noise": "../../run.sh enterprise_it_harnessing/elk_harnessing/harness.py --once \"Propose grafana_silence_alert for a noisy orders-api warning. Never silence matching-engine or HMAC. Wait for approval.\"",
    "pipeline-shopify": "../../run.sh enterprise_it_harnessing/elk_harnessing/harness.py --once \"Check whether shopify-webhook-ingress events are reaching es-shopify-prod. Search hmac_failed and ingest_lag.\"",
    "pipeline-forex": "../../run.sh enterprise_it_harnessing/elk_harnessing/harness.py --once \"Check fx-trade-capture pipeline into es-forex-prod. Alias forex-trades.\""
  }
}
