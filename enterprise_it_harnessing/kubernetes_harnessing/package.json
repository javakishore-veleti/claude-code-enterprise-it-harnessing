{
  "name": "enterprise-k8s-harnessing",
  "private": true,
  "scripts": {
    "repl": "../../run.sh enterprise_it_harnessing/kubernetes_harnessing/harness.py",
    "identity": "../../run.sh enterprise_it_harnessing/kubernetes_harnessing/harness.py --tool cloud_identity",
    "skills": "../../run.sh enterprise_it_harnessing/kubernetes_harnessing/harness.py --tool list_skills",
    "load-skill": "../../run.sh enterprise_it_harnessing/kubernetes_harnessing/harness.py --tool load_skill",
    "list-units": "../../run.sh enterprise_it_harnessing/kubernetes_harnessing/harness.py --tool list_business_units",
    "list-forex-markets": "../../run.sh enterprise_it_harnessing/kubernetes_harnessing/harness.py --tool list_services --bu forex-markets",
    "list-shopify-merchants": "../../run.sh enterprise_it_harnessing/kubernetes_harnessing/harness.py --tool list_services --bu shopify-merchants",
    "pods-forex-markets": "../../run.sh enterprise_it_harnessing/kubernetes_harnessing/harness.py --once \"kube_get pods for business_unit=forex-markets on eks-forex-markets-prod.\"",
    "pods-forex-settlement": "../../run.sh enterprise_it_harnessing/kubernetes_harnessing/harness.py --once \"kube_get pods for business_unit=forex-settlement.\"",
    "pods-ecom-retail": "../../run.sh enterprise_it_harnessing/kubernetes_harnessing/harness.py --once \"kube_get pods for business_unit=ecommerce-retail on aks-ecom-retail-prod.\"",
    "pods-ecom-quote": "../../run.sh enterprise_it_harnessing/kubernetes_harnessing/harness.py --once \"kube_get pods for business_unit=ecommerce-quote.\"",
    "pods-fulfillment": "../../run.sh enterprise_it_harnessing/kubernetes_harnessing/harness.py --once \"kube_get pods for business_unit=fulfillment on gke-fulfillment-prod.\"",
    "pods-customer-profile": "../../run.sh enterprise_it_harnessing/kubernetes_harnessing/harness.py --once \"kube_get pods for business_unit=customer-profile.\"",
    "pods-customer-support": "../../run.sh enterprise_it_harnessing/kubernetes_harnessing/harness.py --once \"kube_get pods for business_unit=customer-support.\"",
    "pods-customer-advisor": "../../run.sh enterprise_it_harnessing/kubernetes_harnessing/harness.py --once \"kube_get pods for business_unit=customer-advisor.\"",
    "pods-product-research": "../../run.sh enterprise_it_harnessing/kubernetes_harnessing/harness.py --once \"kube_get pods for business_unit=product-research.\"",
    "pods-shopify-merchants": "../../run.sh enterprise_it_harnessing/kubernetes_harnessing/harness.py --once \"kube_get pods for business_unit=shopify-merchants on eks-shopify-merchants-prod.\"",
    "describe-fx-matching": "../../run.sh enterprise_it_harnessing/kubernetes_harnessing/harness.py --once \"kube_describe service=fx-matching-engine. Load crashloop if CrashLoopBackOff.\"",
    "describe-shopify-webhooks": "../../run.sh enterprise_it_harnessing/kubernetes_harnessing/harness.py --once \"kube_describe service=shopify-webhook-ingress.\"",
    "describe-orders-api": "../../run.sh enterprise_it_harnessing/kubernetes_harnessing/harness.py --once \"kube_describe service=orders-api.\"",
    "logs-fx-matching": "../../run.sh enterprise_it_harnessing/kubernetes_harnessing/harness.py --once \"kube_logs service=fx-matching-engine tail=200. Summarize rejects.\"",
    "logs-shopify-webhooks": "../../run.sh enterprise_it_harnessing/kubernetes_harnessing/harness.py --once \"kube_logs service=shopify-webhook-ingress. Summarize HMAC failures.\"",
    "logs-legacy-bridge": "../../run.sh enterprise_it_harnessing/kubernetes_harnessing/harness.py --once \"kube_logs service=shopify-legacy-bridge. Look for SOAP/AS400 timeouts.\"",
    "logs-checkout": "../../run.sh enterprise_it_harnessing/kubernetes_harnessing/harness.py --once \"kube_logs service=checkout-orchestrator.\"",
    "creds-forex-markets": "../../run.sh enterprise_it_harnessing/kubernetes_harnessing/harness.py --once \"kube_refresh_credentials for business_unit=forex-markets (EKS). Wait for approval.\"",
    "creds-ecom-retail": "../../run.sh enterprise_it_harnessing/kubernetes_harnessing/harness.py --once \"kube_refresh_credentials for business_unit=ecommerce-retail (AKS). Wait for approval.\"",
    "creds-fulfillment": "../../run.sh enterprise_it_harnessing/kubernetes_harnessing/harness.py --once \"kube_refresh_credentials for business_unit=fulfillment (GKE). Wait for approval.\"",
    "creds-shopify": "../../run.sh enterprise_it_harnessing/kubernetes_harnessing/harness.py --once \"kube_refresh_credentials for business_unit=shopify-merchants (EKS). Wait for approval.\"",
    "restart-shopify-retry": "../../run.sh enterprise_it_harnessing/kubernetes_harnessing/harness.py --once \"Propose kube_rollout_restart of shopify-webhook-retry. Wait for approval.\"",
    "restart-fx-session": "../../run.sh enterprise_it_harnessing/kubernetes_harnessing/harness.py --once \"Propose kube_rollout_restart of fx-session-manager. Avoid matching-engine peak. Wait for approval.\""
  }
}
